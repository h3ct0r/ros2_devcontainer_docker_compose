# Copy to .env and adjust; docker compose reads it automatically.

# Image target: base | robot | desktop | full
TARGET=full

# ROS 2
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0

# Middleware: dds (Fast DDS, default) | zenoh (rmw_zenoh + router) | bridge (CycloneDDS + zenoh-bridge-ros2dds)
ROS_TRANSPORT=dds
# Comma-separated Zenoh endpoints to join, e.g. the robot: tcp/192.168.1.50:7447
ZENOH_CONNECT=
# bridge only: prefix for everything leaving this host, e.g. /bot1
ZENOH_NAMESPACE=

# Passwords: ssh user (ubuntu, or root in rootless mode); VNC and code-server are open when empty
DEV_PASSWORD=ubuntu
VNC_PASSWORD=
CODE_SERVER_PASSWORD=

TZ=UTC
