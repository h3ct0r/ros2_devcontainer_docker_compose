# Copy to .env and adjust: ./dev.sh, docker compose and the devcontainers read it.
# ./dev.sh status shows what each setting resolved to and why.

# ROS 2 distro (humble | jazzy | lyrical) and image (base | robot | desktop | full).
# In VS Code the devcontainer you open picks the distro.
ROS_DISTRO=jazzy
TARGET=desktop

# Host setup. "auto" detects this machine; any other value wins over the detection.
GPU=auto          # auto | none | nvidia | jetson
MODE=auto         # auto | rootful | rootless
NETWORK=auto      # auto | host | bridge (host on Linux, bridge with published ports on macOS)
DEVICES=auto      # auto | none | all (the host's /dev, privileged)
PLATFORM=native   # native | linux/amd64 | linux/arm64 (the other one runs emulated)

# ROS
ROS_DOMAIN_ID=0
ROS_DISCOVERY=subnet   # subnet | localhost
ROS_TRANSPORT=dds      # dds (Fast DDS) | zenoh (rmw_zenoh + router) | bridge (CycloneDDS + zenoh-bridge-ros2dds)
ZENOH_CONNECT=         # comma-separated Zenoh endpoints to join, e.g. tcp/192.168.1.50:7447
ZENOH_NAMESPACE=       # bridge only: prefix for everything leaving this host, e.g. /bot1

# Passwords: ssh (user ubuntu, or root in rootless mode); VNC and code-server are open when empty
DEV_PASSWORD=ubuntu
VNC_PASSWORD=
CODE_SERVER_PASSWORD=

# Host ports with bridge networking; change them to run several distros side by side
NOVNC_PORT=3080
CODE_SERVER_PORT=3081
SSH_PORT=3022
VNC_PORT=5902
ZENOH_PORT=7447

TZ=UTC
# WORKSPACE=./local_mount       # host folder mounted as ~/ros2_ws
# IMAGE=h3ct0rdcc/ros2_dev      # image repository
